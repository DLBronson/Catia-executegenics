(VERICUT SAMPLE CONTROL MCD SUBROUTINE FILE: hascnc.sub)
%
(  O707000      G70 Bolt Hole Circle)
(  O717100      G71 Bolt Hole Arc)
(  O727200      G72 Bolt Hole Along An Angle)

(  Variable     Description)
(  5001         X-axis current tool tip location)
(  5002         Y-axis current tool tip location)
(  CENTERX      X-axis center of Bolt Hole Circle/Arc - used in G70/G71 sub)
(  CENTERX      Y-axis center of Bolt Hole Circle/Arc - used in G70/G71 sub)
(  COUNTER      Counter for number of bolt holes - used in G70/G71/G72 sub)
(  DELTAANGLE   Angle between Bolt Holes - K with G71)
(  DELTADIST    Distance between holes - I with G72)
(  ENDANGLE     End angle of Bolt Holes - G70/G71)
(  LINEANGLE    Angle for Bolt Holes Along An Angle - J with G72)
(  QTYHOLES     Number of holes on Bolt Hole Circle - L with G70/G71/G72)
(  POSANGLE     Angle position of each Bolt Hole - used in G70/G71/G72 sub)
(  POSX         X-axis position of each Bolt Hole - used in G70/G71/G72 sub)
(  POSY         X-axis position of each Bolt Hole - used in G70/G71/G72 sub)
(  RADIUS       Bolt Hole Circle radius - I with G70/G71)
(  STARTANGLE   Start angle of Bolt Holes - J with G70/G71)
(  STARTX       X-axis start location - used in G72 sub)
(  STARTY       Y-axis start location - used in G72 sub)

(********************************************************************)
O707000
(VERICUT SAMPLE CONTROL MCD SUBROUTINE: G70 Bolt Hole Circle)

#104003=#4003                     (Save G90/G91 Abso/Inco Mode)
G90

POSX=0
POSY=0
POSANGLE=STARTANGLE
COUNTER=0                         (Counter for the number of bolt holes)
CENTERX=#5001                     (X-axis center of Bolt Hole Circle)
CENTERY=#5002                     (Y-axis center of Bolt Hole Circle)
DELTAANGLE=[360/QTYHOLES]         (Define Angle between Bolt Holes, as not in G70 block)
ENDANGLE=[STARTANGLE+360]         (Define End angle of Bolt Holes, as not in G70 block)

N707010                           (Sequence for calculating each location on the bolt hole circle)
POSX=CENTERX+[RADIUS*COS[POSANGLE]] (Calculate the X-coordinate for each location)
POSY=CENTERY+[RADIUS*SIN[POSANGLE]] (Calculate the Y-coordinate for each location)

X POSX Y POSY

COUNTER=COUNTER+1                 (Increment the counter for the number of bolt holes)
POSANGLE=POSANGLE+[DELTAANGLE]    (Calculate the next angle)
IF [COUNTER LT QTYHOLES] AND [POSANGLE LT ENDANGLE] GOTO 707010

G#104003                          (Restore G90/G91 Abso/Inco Mode)
M99

(********************************************************************)
O717100
(VERICUT SAMPLE CONTROL MCD SUBROUTINE: G71 Bolt Hole Arc)

#104003=#4003                     (Save G90/G91 Abso/Inco Mode)
G90

POSX=0
POSY=0
POSANGLE=STARTANGLE
COUNTER=0                         (Counter for the number of bolt holes)
CENTERX=#5001                     (X-axis center of Bolt Hole Arc)
CENTERY=#5002                     (Y-axis center of Bolt Hole Arc)
ENDANGLE=[STARTANGLE+[DELTAANGLE*[QTYHOLES-1]]] (Define End angle of Bolt Holes, as not in G71 block)

N717110                           (Sequence for calculating each location on the bolt hole circle)
POSX=CENTERX+[RADIUS*COS[POSANGLE]] (Calculate the X-coordinate for each location)
POSY=CENTERY+[RADIUS*SIN[POSANGLE]] (Calculate the Y-coordinate for each location)

X POSX Y POSY

COUNTER=COUNTER+1                 (Increment the counter for the number of bolt holes)
POSANGLE=POSANGLE+[DELTAANGLE]    (Calculate the next angle)
IF [COUNTER LE QTYHOLES] AND [POSANGLE LE ENDANGLE] GOTO 717110

G#104003                          (Restore G90/G91 Abso/Inco Mode)
M99

(********************************************************************)
O727200
(VERICUT SAMPLE CONTROL MCD SUBROUTINE: G72 Bolt Holes Along An Angle)

#104003=#4003                     (Save G90/G91 Abso/Inco Mode)
G90

POSX=0
POSY=0
POSANGLE=STARTANGLE
COUNTER=0                         (Counter for the number of holes)
STARTX=#5001                      (X-axis start location)
STARTY=#5002                      (Y-axis start location)

N727210                           (Sequence for calculating each location)
POSX=STARTX+[COUNTER*DELTADIST*COS[LINEANGLE]] (Calculate the next X-coordinate location)
POSY=STARTY+[COUNTER*DELTADIST*SIN[LINEANGLE]] (Calculate the next Y-coordinate location)

X POSX Y POSY
				
COUNTER=COUNTER+1                 (Increment the counter for the number of holes)
IF [COUNTER LT QTYHOLES] GOTO 727210

G#104003                          (Restore G90/G91 Abso/Inco Mode)
M99

(********************************************************************)

