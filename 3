    <script type="text/javascript" src="/lib/select2/js/select2.min.js"></script>

    <script type="text/javascript">

        $(document).ready(() => {

            $('#tagPicker').select2( {
                theme: "bootstrap-5",
                width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
                placeholder: $( this ).data( 'placeholder' ),
                closeOnSelect: false,
                selectionCssClass: "select2--small",
                //dropdownCssClass: "select2--small" -- this doesn't seem to be working even tho is in the docs like this.
            });

            // URLSearchParams is case-sensitive but ASP.NET's query collection is not, so a key we
            // write in one casing sits alongside the same key in another casing and both get bound
            // as a single comma-joined value. Drop every casing variant before writing ours. These
            // names have to stay in sync with Selections.ToDictionary(), which builds the
            // pagination links.
            const dropParam = (url, pattern) =>
            {
                [...url.searchParams.keys()]
                    .filter(key => pattern.test(key))
                    .forEach(key => url.searchParams.delete(key));
            };

            const setParam = (url, name, value) =>
            {
                dropParam(url, new RegExp('^' + name + '$', 'i'));

                if (value !== null && value !== undefined && value !== '')
                {
                    url.searchParams.set(name, value);
                }
            };

            // '-1' is the "Any" option on every picker, which means no filter at all.
            const pickerValue = (selector) =>
            {
                const value = $(selector).val();

                return value === '-1' ? null : value;
            };

            $('#searchForm').submit((e) => {

                e.preventDefault();

                // Create a URL object from the current location
                var url = new URL(window.location.href);

                setParam(url, 'partType', pickerValue('#partTypePicker'));
                setParam(url, 'version', pickerValue('#versionPicker'));
                setParam(url, 'units', pickerValue('#unitPicker'));
                setParam(url, 'product', pickerValue('#productPicker'));
                setParam(url, 'industry', pickerValue('#industryPicker'));
                setParam(url, 'sortBy', pickerValue('#sortPicker'));
                setParam(url, 'pageSize', pickerValue('#pageSizePicker'));
                setParam(url, 'keywords', $('#keywordInput').val());

                // Tags are indexed - tags[0], tags[1] - so clear the whole set before rewriting it.
                dropParam(url, /^tags(\[\d+\])?$/i);

                [].concat($('#tagPicker').val() ?? [])
                    .filter(tag => tag !== '' && tag !== '-1')
                    .forEach((tag, index) => url.searchParams.set('tags[' + index + ']', tag));

                // A new search starts over at the first page.
                dropParam(url, /^currentPage$/i);

                // Navigate to the new URL
                window.location.href = url.toString();
            });

            $('#clearSearchButton').click((e) => {

                e.preventDefault();

                $('#partTypePicker').val(''); // Reset the part type picker to default value
                $('#versionPicker').val(''); // Reset the version picker to default value
                $('#unitPicker').val(''); // Reset the unit picker to default value
                $('#productPicker').val(''); // Reset the product picker to default value
                $('#industryPicker').val(''); // Reset the industry picker to default value
                $('#sortPicker').val(''); // Reset the sort picker to default value
                $('#pageSizePicker').val(''); // Reset the page size picker to default value
                $('#keywordInput').val(''); // Reset the keyword input to default value
                $('#tagPicker').val(''); // Reset the tag picker to default value

                var currentRef = window.location.href.split('?')[0]
            
                window.location.href = currentRef;
            });

        });

    </script>


